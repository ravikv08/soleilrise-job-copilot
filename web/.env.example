# Copy to .env.local and fill in. Never commit .env.local.

# Postgres. Any provider works — Neon and Supabase both give a free database.
# Supabase: use the "Connection pooling" string (port 6543) for the app.
DATABASE_URL="postgresql://user:password@host:5432/soleilrise?sslmode=require"
# Each serverless instance opens its own pool; prefer a pooled connection
# string (Supabase port 6543, Neon pooled host) over raising this.
DATABASE_POOL_MAX="3"

# Anthropic. Server-side only; this key must never reach the browser.
ANTHROPIC_API_KEY="sk-ant-..."

# Spend limits per user. Without these, one account can run the key to any
# amount. Raise them once ai_usage shows what real use costs.
QUOTA_MONTHLY_USD="5"
QUOTA_HOURLY_CALLS="30"

# Auth.js. Generate the secret with:  npx auth secret
AUTH_SECRET=""
# In production set this to your real origin, e.g. https://app.soleilrise.com
AUTH_URL="http://localhost:3002"

# At least one provider is required to sign in. Configure either or both.
# Both halves of a provider are required; with only one set, that provider
# is skipped and no button appears for it.
# Google:  https://console.cloud.google.com/apis/credentials
#   Authorised redirect URI: http://localhost:3002/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# GitHub:  https://github.com/settings/developers
#   Authorisation callback URL: http://localhost:3002/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
